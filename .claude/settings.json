{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["angular-cli", "primeng"],
  "permissions": {
    "allow": [
      "Bash(npm start)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run build:dev)",
      "Bash(npm run verify)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test:watch)",
      "Bash(npx ng generate:*)",
      "Bash(npx ng g:*)",
      "Bash(npx ng version)",
      "Bash(npx prettier:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__angular-cli",
      "mcp__primeng"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx ng update:*)",
      "Bash(npx ng add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./package-lock.json)",
      "Edit(./node_modules/**)",
      "Edit(./dist/**)",
      "Edit(./.angular/**)"
    ]
  }
}
